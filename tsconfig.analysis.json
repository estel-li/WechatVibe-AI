{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "outDir": "dist-analysis",
    "rootDir": ".",
    "sourceMap": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["analysis/**/*.ts", "shared/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-analysis", "tests", "scripts", "src"]
}
